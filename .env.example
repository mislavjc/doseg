# Isochrone service URL (Rust server)
ISOCHRONE_URL=http://localhost:3002

# OTP URL (used by isochrone server at startup)
# Local: http://localhost:8080 (run `docker compose up otp`)
# Via SSH tunnel: http://localhost:8080 (run `ssh -NL 8080:<ip>:8080 netcup`)
OTP_URL=http://localhost:8080

# Data directory for walk graph, district scores, etc.
DATA_DIR=data

# Isochrone server port
PORT=3002

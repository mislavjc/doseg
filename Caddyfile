{$DOMAIN:localhost} {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# X-Frame-Options DENY blocks <object> from loading SVGs; omit for embeddable assets
	@embeddable path /district-map.svg
	header @embeddable -X-Frame-Options

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	@assets path *.svg *.png *.ico *.webp
	header @assets Cache-Control "public, max-age=604800"

	reverse_proxy app:3000
}
